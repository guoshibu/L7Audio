<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.aug32.l7audio">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Android 14+ 使用 microphone 类型前台服务必须单独申请；targetSdk 30 上声明无害。
         为什么需要：车机在后台只允许"使用中"的应用录音，前台服务必须声明 microphone 类型，
         否则系统会以 AppOps(op 27 = RECORD_AUDIO) 拒绝 AudioRecord 建流
         （logcat: Request denied by app op: 27 / recording not allowed for uid ...） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:ignore="Deprecated" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:ignore="Deprecated" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:name=".L7AudioApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher_playstore"
        android:roundIcon="@drawable/ic_launcher_playstore"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.L7Audio"
        android:requestLegacyExternalStorage="true">
        <activity
            android:name=".ui.activity.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenLayout|keyboardHidden|uiMode"
            android:screenOrientation="sensor">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.activity.MicToggleActivity"
            android:exported="true"
            android:theme="@style/Theme.L7Audio.Transparent"
            android:excludeFromRecents="true"
            android:screenOrientation="sensor">
            <intent-filter>
                <action android:name="com.aug32.l7audio.ACTION_TOGGLE_MIC" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.player.AudioForegroundService"
            android:foregroundServiceType="mediaPlayback|microphone"
            android:exported="false"
            android:stopWithTask="false" />

        <service
            android:name=".service.floating.FloatingWindowService"
            android:foregroundServiceType="mediaPlayback|microphone"
            android:exported="false"
            android:stopWithTask="false" />

        <!-- 开机自启接收器：必须保持默认 enabled。
             修复：此前 enabled="false" 且全工程没有任何 setComponentEnabledSetting 恢复代码，
             组件被永久禁用，BOOT_COMPLETED 广播永远收不到，开机自启功能整体失效。
             是否自启由接收器内部 AppConfig.isAutoStartOnBoot() 开关控制，组件层无需禁用 -->
        <receiver
            android:name=".receiver.boot.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".receiver.micoutput.MicOutputReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.aug32.l7audio.OUTSIDE_MIC_TOGGLE" />
            </intent-filter>
        </receiver>
    </application>

</manifest>