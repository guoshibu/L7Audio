<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Main content container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Main interface -->
        <LinearLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="?attr/colorSurface">

            <!-- Top: Title bar -->
            <LinearLayout
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:gravity="center_vertical"
                android:background="?attr/colorSurfaceVariant">

                <!-- 顶栏方形按钮：高度改 wrap_content + minHeight/minWidth，字号放大时按钮跟着长高不裁字（横屏边界：车机横屏顶栏空间充裕，minHeight 64dp 兜底保证触控面积） -->
                <Button
                    android:id="@+id/btn_menu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/min_width_main_toolbar_btn"
                    android:minHeight="@dimen/min_height_main_toolbar_btn"
                    android:layout_margin="4dp"
                    android:text="☰"
                    android:textSize="@dimen/text_main_toolbar_icon"
                    android:backgroundTint="?attr/colorPrimary"
                    android:textColor="?attr/colorOnPrimary"
                    android:elevation="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"   
                    android:insetRight="0dp"  
                    android:gravity="center"   
                    android:padding="0dp"      
                    app:cornerRadius="12dp" />

                <TextView
                    android:id="@+id/tv_app_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="L7 Audio"
                    android:textSize="@dimen/text_main_title"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold"
                    android:gravity="center" />

                <!-- 顶栏方形按钮：同 btn_menu，wrap_content + minHeight/minWidth 兜底，字号放大不裁字 -->
                <Button
                    android:id="@+id/btn_exit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/min_width_main_toolbar_btn"
                    android:minHeight="@dimen/min_height_main_toolbar_btn"
                    android:layout_margin="4dp"
                    android:text="✕"
                    android:textSize="@dimen/text_main_toolbar_icon"
                    android:backgroundTint="?attr/colorPrimary"
                    android:textColor="?attr/colorOnPrimary"
                    android:elevation="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:insetLeft="0dp"   
                    android:insetRight="0dp"  
                    android:gravity="center"   
                    android:padding="0dp"      
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <!-- Middle: Content area -->
            <LinearLayout
                android:id="@+id/content_area"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="?attr/colorSurface">

                <!-- Output control buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="4dp"
                    android:gravity="center">

                    <!-- 输出切换按钮：高度改 wrap_content + minHeight，字号放大随之长高（横屏边界：两颗按钮 weight=1 均分宽度，横屏下宽度充足，仅高度需随字号联动） -->
                    <Button
                        android:id="@+id/btn_output_car"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/min_height_main_output_btn"
                        android:layout_weight="1"
                        android:layout_margin="4dp"
                        android:text="仅车内"
                        android:textSize="@dimen/text_main_output_btn"
                        android:backgroundTint="?attr/colorPrimary"
                        android:textColor="?attr/colorOnPrimary"
                        android:elevation="4dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="10dp" />

                    <Button
                        android:id="@+id/btn_output_external"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="@dimen/min_height_main_output_btn"
                        android:layout_weight="1"
                        android:layout_margin="4dp"
                        android:text="仅车外"
                        android:textSize="@dimen/text_main_output_btn"
                        android:backgroundTint="?attr/colorPrimary"
                        android:textColor="?attr/colorOnPrimary"
                        android:elevation="4dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        app:cornerRadius="10dp" />
                </LinearLayout>

                <!-- Function content area -->
                <FrameLayout
                    android:id="@+id/function_content"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="?attr/colorSurface">

                    <!-- This area will be used to display different function pages -->

                </FrameLayout>

            </LinearLayout>

            <!-- Bottom: Core function buttons -->
            <LinearLayout
                android:id="@+id/bottom_buttons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:gravity="center"
                android:background="?attr/colorSurfaceVariant">

                <!-- 底部功能按钮：已是 wrap_content 高度，textSize 与 minHeight 均 dimens 化，随字号联动 -->
                <Button
                    android:id="@+id/btn_mic_amplifier"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="🎤 麦克风"
                    android:textSize="@dimen/text_main_bottom_btn"
                    android:backgroundTint="?attr/colorPrimary"
                    android:textColor="?attr/colorOnPrimary"
                    android:elevation="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="@dimen/min_height_main_bottom_btn"
                    app:cornerRadius="12dp" />

                <Button
                    android:id="@+id/btn_tts"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="📢 TTS"
                    android:textSize="@dimen/text_main_bottom_btn"
                    android:backgroundTint="?attr/colorPrimary"
                    android:textColor="?attr/colorOnPrimary"
                    android:elevation="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="@dimen/min_height_main_bottom_btn"
                    app:cornerRadius="12dp" />

                <Button
                    android:id="@+id/btn_music_player"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_margin="4dp"
                    android:text="🎵 音乐"
                    android:textSize="@dimen/text_main_bottom_btn"
                    android:backgroundTint="?attr/colorPrimary"
                    android:textColor="?attr/colorOnPrimary"
                    android:elevation="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="@dimen/min_height_main_bottom_btn"
                    app:cornerRadius="12dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Fragment container -->
        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Navigation drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="false"
        android:background="@color/nav_background"
        android:elevation="8dp"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/navigation_menu"
        app:itemTextAppearance="@style/NavigationMenuTextAppearance"
        app:subheaderTextAppearance="@style/NavigationSubheaderTextAppearance"
        app:itemBackground="@drawable/nav_item_background"
        app:itemIconTint="@color/nav_icon_color_selector"
        app:itemTextColor="@color/nav_text_color_selector"
        app:itemIconSize="32dp"
        app:itemIconPadding="20dp"
        app:itemHorizontalPadding="20dp"
        app:itemVerticalPadding="24dp"
        app:dividerInsetStart="16dp"
        app:dividerInsetEnd="16dp"
        app:subheaderInsetStart="16dp" />

</androidx.drawerlayout.widget.DrawerLayout>