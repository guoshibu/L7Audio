<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Toolbar -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="15dp"
        android:paddingBottom="8dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="center_vertical"
        android:background="@color/menu_background">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:text="←"
            android:textSize="@dimen/text_about_toolbar"
            android:minWidth="64dp"
            android:minHeight="64dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/button_background"
            android:textColor="@color/button_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="关于"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_about_toolbar"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_home"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:text="⌂"
            android:textSize="@dimen/text_about_toolbar"
            android:minWidth="64dp"
            android:minHeight="64dp"
            android:backgroundTint="@color/button_background"
            android:textColor="@color/button_text" />
    </LinearLayout>

    <!-- About content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center">

            <!-- App Logo -->
            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="24dp"
                android:src="@drawable/ic_launcher_playstore" />

            <!-- App Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="银河L7音频工具"
                android:textSize="@dimen/text_about_app_name"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginBottom="16dp" />

            <!-- Version -->
            <TextView
                android:id="@+id/tv_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="版本 1.0.0"
                android:textSize="@dimen/text_about_body"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginBottom="32dp" />

            <!-- Project URL -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="项目地址"
                        android:textSize="@dimen/text_about_section"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="https://github.com/guoshibu/L7Audio"
                        android:textSize="@dimen/text_about_body"
                        android:textColor="?attr/colorOnSurface"
                        android:breakStrategy="simple"
                        android:hyphenationFrequency="none"
                        android:linksClickable="true"
                        android:autoLink="web" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- QR Code -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="扫码加入群聊"
                        android:textSize="@dimen/text_about_section"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="16dp" />

                    <ImageView
                        android:id="@+id/iv_qr_code"
                        android:layout_width="200dp"
                        android:layout_height="200dp"
                        android:src="@drawable/qr_code_qq_group" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="群号：159045907"
                        android:textSize="@dimen/text_about_caption"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginTop="16dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- 免责声明卡片：软件性质 + 免责（保留用户原话，措辞上加“在法律允许的最大范围内”以规避绝对免责条款在中国法下可能部分无效的风险） -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="免责声明"
                        android:textSize="@dimen/text_about_section"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="本软件仅供学习交流使用，请遵守相关法律法规。在法律允许的最大范围内，使用本软件所造成的车机系统故障、数据丢失或任何损失，作者不承担任何责任。"
                        android:textSize="@dimen/text_about_caption"
                        android:lineSpacingMultiplier="1.3"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- 隐私说明卡片：纯本地、不联网、不收集，麦克风仅实时处理不落盘 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="隐私说明"
                        android:textSize="@dimen/text_about_section"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="本应用为本地音频工具，不收集、不上传、不共享任何个人信息，无需注册账号，不接入任何网络服务。\n\n麦克风仅用于“车外喊话”与“音量放大”功能的实时音频处理，音频数据仅在设备本地实时处理，不录音、不存储、不上传。\n\n应用运行所需的全部数据均保存在本机，卸载应用即随之清除。"
                        android:textSize="@dimen/text_about_caption"
                        android:lineSpacingMultiplier="1.3"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- 权限说明卡片：最小必要原则，逐条说明用途 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="权限说明"
                        android:textSize="@dimen/text_about_section"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="本应用遵循最小必要原则申请以下权限：\n\n· 存储权限：仅用于读取本机音频文件以进行播放，不会访问与播放无关的文件。\n· 麦克风权限：仅用于“车外喊话/音量放大”功能的实时采集，不录音、不留存。\n· 悬浮窗权限：仅用于在其他界面上显示播放控制悬浮窗，可在系统设置中关闭。"
                        android:textSize="@dimen/text_about_caption"
                        android:lineSpacingMultiplier="1.3"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- 使用须知卡片：车外喊话/音量放大功能的合规使用边界（普通车辆行驶中对外扩音在中国大陆受限，明确责任划归使用者） -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="使用须知"
                        android:textSize="@dimen/text_about_section"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="“车外喊话/音量放大”功能仅供在法律法规允许的场合下使用（如车辆驻停、封闭场地或私人区域等）。请勿在道路行驶过程中对车外扩音喊话；普通车辆对外扩音可能违反道路交通安全及噪声管理相关规定。因违规使用产生的一切后果由使用者自行承担。"
                        android:textSize="@dimen/text_about_caption"
                        android:lineSpacingMultiplier="1.3"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- 开源许可卡片：media3 (ExoPlayer) 遵循 Apache License 2.0，履行开源合规义务 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="开源许可"
                        android:textSize="@dimen/text_about_section"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="本应用音频播放功能基于 AndroidX Media3（ExoPlayer），遵循 Apache License 2.0 开源协议。"
                        android:textSize="@dimen/text_about_caption"
                        android:lineSpacingMultiplier="1.3"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Copyright -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="© 2026 银河L7音频工具"
                android:textSize="@dimen/text_about_caption"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginBottom="32dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
