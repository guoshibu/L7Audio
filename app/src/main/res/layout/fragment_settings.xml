<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Toolbar -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="15dp"
        android:paddingBottom="8dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:gravity="center_vertical"
        android:background="@color/menu_background">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:text="←"
            android:textSize="24sp"
            android:minWidth="64dp"
            android:minHeight="64dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/button_background"
            android:textColor="@color/button_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="设置"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_home"
            android:layout_width="wrap_content"
            android:layout_height="64dp"
            android:text="⌂"
            android:textSize="24sp"
            android:minWidth="64dp"
            android:minHeight="64dp"
            android:backgroundTint="@color/button_background"
            android:textColor="@color/button_text" />
    </LinearLayout>

    <!-- Settings content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

        <!-- Theme settings -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_title"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/theme_radio_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/theme_system"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="跟随系统"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp" />

                    <RadioButton
                        android:id="@+id/theme_light"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="浅色主题"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp" />

                    <RadioButton
                        android:id="@+id/theme_dark"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="深色主题"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="16sp" />

                </RadioGroup>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Auto start settings -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_auto_start"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="16sp" />

                <Switch
                    android:id="@+id/auto_start_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Audio Device settings -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="音频设备设置"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="78dp"
                    android:layout_marginTop="16dp">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_width="169dp"
                        android:layout_height="wrap_content"
                        android:text="车外输出设备"/>
                    <EditText
                        android:textSize="16sp"
                        android:textColor="?attr/colorOnSurface"
                        android:gravity="center"
                        android:id="@+id/edit_audio_usage_external"
                        android:background="?attr/colorSurface"
                        android:layout_width="143dp"
                        android:layout_height="48dp"
                        android:hint="15"
                        android:maxLength="3"
                        android:inputType="number"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"/>
                    <Button
                        android:textSize="16sp"
                        android:textColor="?attr/colorOnSurface"
                        android:id="@+id/btn_enum_outputs"
                        android:layout_width="wrap_content"
                        android:layout_height="56dp"
                        android:minWidth="120dp"
                        android:text="枚举设备"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:layout_marginStart="12dp" 
                        android:backgroundTint="@color/button_background"/>
                </LinearLayout>

                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="78dp"
                    android:layout_marginTop="12dp">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_width="169dp"
                        android:layout_height="wrap_content"
                        android:text="车内输出设备"/>
                    <EditText
                        android:textSize="16sp"
                        android:textColor="?attr/colorOnSurface"
                        android:gravity="center"
                        android:id="@+id/edit_audio_usage_car"
                        android:background="?attr/colorSurface"
                        android:layout_width="143dp"
                        android:layout_height="48dp"
                        android:hint="1"
                        android:maxLength="3"
                        android:inputType="number"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"/>
                    <Button
                        android:textSize="16sp"
                        android:textColor="?attr/colorOnSurface"
                        android:id="@+id/btn_enum_car_outputs"
                        android:layout_width="wrap_content"
                        android:layout_height="56dp"
                        android:minWidth="120dp"
                        android:text="枚举设备"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:layout_marginStart="12dp" 
                        android:backgroundTint="@color/button_background"/>
                </LinearLayout>

                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="78dp"
                    android:layout_marginTop="12dp">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_width="169dp"
                        android:layout_height="wrap_content"
                        android:text="麦克风源"/>
                    <EditText
                        android:textSize="16sp"
                        android:textColor="?attr/colorOnSurface"
                        android:gravity="center"
                        android:id="@+id/edit_audio_source"
                        android:background="?attr/colorSurface"
                        android:layout_width="143dp"
                        android:layout_height="48dp"
                        android:hint="1"
                        android:maxLength="3"
                        android:inputType="number"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"/>
                    <Button
                        android:textSize="16sp"
                        android:textColor="?attr/colorOnSurface"
                        android:id="@+id/btn_enum_mics"
                        android:layout_width="wrap_content"
                        android:layout_height="56dp"
                        android:minWidth="120dp"
                        android:text="枚举设备"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:layout_marginStart="12dp" 
                        android:backgroundTint="@color/button_background"/>
                </LinearLayout>

                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="78dp"
                    android:layout_marginTop="12dp">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="?attr/colorOnSurface"
                        android:layout_width="169dp"
                        android:layout_height="wrap_content"
                        android:text="最大放大倍数"/>
                    <EditText
                        android:textSize="16sp"
                        android:textColor="?attr/colorOnSurface"
                        android:gravity="center"
                        android:id="@+id/edit_max_amplification"
                        android:background="?attr/colorSurface"
                        android:layout_width="143dp"
                        android:layout_height="48dp"
                        android:hint="2"
                        android:maxLength="1"
                        android:inputType="number"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"/>
                </LinearLayout>

                <Button
                    android:id="@+id/btn_save_audio_device"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:text="保存音频设备设置"
                    android:textSize="16sp" 
                    android:backgroundTint="@color/button_background"
                    android:textColor="@color/button_text"/>

                <TextView
                    android:id="@+id/tv_audio_device_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="点击保存按钮应用设置"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp"
                    android:layout_marginTop="12dp"
                    android:maxLines="5" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- TTS Diagnostics -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TTS 诊断"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_tts_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="点击按钮测试TTS状态"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp"
                    android:layout_marginTop="8dp"
                    android:scrollbars="vertical"
                    android:maxLines="10" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">

                    <Button
                        android:id="@+id/btn_test_tts"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="测试TTS发声"
                        android:textSize="16sp"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="@color/button_background"
                        android:textColor="@color/button_text" />

                    <Button
                        android:id="@+id/btn_check_tts_status"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:text="检查TTS状态"
                        android:textSize="16sp"
                        android:backgroundTint="@color/button_background"
                        android:textColor="@color/button_text" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Debug settings -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="调试设置"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_debug_audio_routes"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:text="显示音频路由"
                    android:textSize="16sp" 
                    android:backgroundTint="@color/button_background"
                    android:textColor="@color/button_text"/>

                <TextView
                    android:id="@+id/tv_audio_routes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="300dp"
                    android:layout_marginTop="16dp"
                    android:text="点击按钮显示音频路由信息"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp"
                    android:scrollbars="vertical"
                    android:scrollbarStyle="insideInset"
                    android:overScrollMode="always"
                    android:singleLine="false"
                    android:maxLines="1000"
                    android:inputType="textMultiLine"
                    android:textIsSelectable="true"
                    android:longClickable="true" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- About settings -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="关于"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_about"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:text="关于应用"
                    android:textSize="16sp" 
                    android:backgroundTint="@color/button_background"
                    android:textColor="@color/button_text"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Other settings can be added here -->

        </LinearLayout>

    </ScrollView>

</LinearLayout>
