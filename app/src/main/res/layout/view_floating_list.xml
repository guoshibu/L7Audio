<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="336dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/floating_list_bg_light"
    android:padding="19dp"
    android:layout_margin="19dp"
    android:elevation="8dp">

    <!-- 标题行：L7 Audio + 设置按钮 + 关闭按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="L7 Audio"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_settings_toggle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="设置"
            android:textSize="17sp"
            android:minWidth="80dp"
            android:minHeight="50dp" />

        <Button
            android:id="@+id/btn_close_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="收起"
            android:textSize="17sp"
            android:minWidth="80dp"
            android:minHeight="50dp" />

    </LinearLayout>

    <!-- 设置区域：透明度 + 宽度（由设置按钮控制显隐） -->
    <LinearLayout
        android:id="@+id/ll_settings_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_alpha_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="悬浮窗透明度"
            android:textSize="17sp" />

        <SeekBar
            android:id="@+id/sb_alpha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:max="100"
            android:progress="80" />

        <TextView
            android:id="@+id/tv_width_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="悬浮窗宽度"
            android:textSize="17sp" />

        <SeekBar
            android:id="@+id/sb_width"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:max="240"
            android:progress="96" />

        <TextView
            android:id="@+id/tv_auto_hide_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="自动收起时长：10 秒"
            android:textSize="17sp" />

        <SeekBar
            android:id="@+id/sb_auto_hide_timeout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:max="25"
            android:progress="5" />

    </LinearLayout>

    <!-- 功能区：车外喊话 + TTS列表（始终可见） -->
    <Button
        android:id="@+id/btn_announcement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp"
        android:text="车外喊话"
        android:textSize="19sp"
        android:minHeight="67dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="19dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_tts_list_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TTS列表"
            android:textSize="19sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_select_tts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="添加"
            android:textSize="17sp"
            android:minWidth="96dp"
            android:minHeight="58dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxHeight="360dp">

        <LinearLayout
            android:id="@+id/ll_tts_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

</LinearLayout>
