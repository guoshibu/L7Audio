<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="?attr/colorSurface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <!-- 麦克风放大状态 -->
    <TextView
        android:id="@+id/tv_amplifier_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="状态: 已停止"
        android:textSize="25sp"
        android:textColor="?attr/colorOnSurface"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 音频处理选项 -->
    <LinearLayout
        android:id="@+id/ll_audio_processing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/colorSurfaceVariant"
        android:padding="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:elevation="4dp"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_amplifier_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tv_noise_reduction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="噪声抑制"
                android:textSize="22sp"
                android:textColor="?attr/colorOnSurface" />

            <android.widget.Switch
                android:id="@+id/sw_noise_reduction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tv_echo_cancellation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="回声抑制"
                android:textSize="22sp"
                android:textColor="?attr/colorOnSurface" />

            <android.widget.Switch
                android:id="@+id/sw_echo_cancellation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_howling_suppression"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="啸叫抑制"
                android:textSize="22sp"
                android:textColor="?attr/colorOnSurface" />

            <android.widget.Switch
                android:id="@+id/sw_howling_suppression"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/tv_agc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="自动增益控制 (AGC)"
                android:textSize="22sp"
                android:textColor="?attr/colorOnSurface" />

            <android.widget.Switch
                android:id="@+id/sw_agc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />

        </LinearLayout>

    </LinearLayout>

    <!-- 放大级别控制 -->
    <LinearLayout
        android:id="@+id/ll_amplification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/colorSurfaceVariant"
        android:padding="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:elevation="4dp"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@+id/ll_audio_processing"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tv_current_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="放大级别:"
                android:textSize="22sp"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/tv_amplification_level"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5"
                android:textSize="22sp"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginStart="16dp" />

        </LinearLayout>

        <SeekBar
            android:id="@+id/sb_amplification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="1">

            <TextView
                android:id="@+id/tv_weak"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.5"
                android:text="弱"
                android:textSize="20sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:gravity="start" />

            <TextView
                android:id="@+id/tv_strong"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.5"
                android:text="强"
                android:textSize="20sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:gravity="end" />

        </LinearLayout>

    </LinearLayout>

    <!-- 开始/停止按钮 -->
    <Button
        android:id="@+id/btn_start_stop"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginHorizontal="30dp"
        android:layout_marginBottom="60dp"
        android:layout_marginTop="24dp"
        android:text="开始放大"
        android:textSize="31sp"
        android:backgroundTint="?attr/colorPrimary"
        android:textColor="?attr/colorOnPrimary"
        app:layout_constraintTop_toBottomOf="@+id/ll_amplification"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
