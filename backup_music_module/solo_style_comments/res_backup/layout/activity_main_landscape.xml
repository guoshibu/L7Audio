<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Main content container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Main interface -->
        <LinearLayout
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/menu_background">

            <!-- Top: Output control buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center">

                <Button
                    android:id="@+id/btn_output_car"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:layout_margin="8dp"
                    android:text="仅车内"
                    android:textSize="16sp"
                    android:backgroundTint="@color/button_background"
                    android:textColor="@color/button_text"
                    android:elevation="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="12dp" />

                <Button
                    android:id="@+id/btn_output_external"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:layout_margin="8dp"
                    android:text="仅车外"
                    android:textSize="16sp"
                    android:backgroundTint="@color/button_background"
                    android:textColor="@color/button_text"
                    android:elevation="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="12dp" />

                <Button
                    android:id="@+id/btn_output_both"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:layout_margin="8dp"
                    android:text="车内+车外"
                    android:textSize="16sp"
                    android:backgroundTint="@color/button_background"
                    android:textColor="@color/button_text"
                    android:elevation="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <!-- Middle: Function buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center">

                <Button
                    android:id="@+id/btn_mic_amplifier"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_weight="1"
                    android:layout_margin="16dp"
                    android:text="🎤 麦克风放大"
                    android:textSize="20sp"
                    android:backgroundTint="@color/button_background"
                    android:textColor="@color/button_text"
                    android:elevation="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="16dp" />

                <Button
                    android:id="@+id/btn_tts"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_weight="1"
                    android:layout_margin="16dp"
                    android:text="📢 TTS 播报"
                    android:textSize="20sp"
                    android:backgroundTint="@color/button_background"
                    android:textColor="@color/button_text"
                    android:elevation="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="16dp" />

                <Button
                    android:id="@+id/btn_music_player"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_weight="1"
                    android:layout_margin="16dp"
                    android:text="🎵 本地音乐"
                    android:textSize="20sp"
                    android:backgroundTint="@color/button_background"
                    android:textColor="@color/button_text"
                    android:elevation="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="16dp" />
            </LinearLayout>

            <!-- Bottom: Control buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center">

                <Button
                    android:id="@+id/btn_menu"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_margin="16dp"
                    android:text="☰"
                    android:textSize="30sp"
                    android:backgroundTint="@color/button_background"
                    android:textColor="@color/button_text"
                    android:elevation="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="12dp" />

                <Button
                    android:id="@+id/btn_exit"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_margin="16dp"
                    android:text="✕"
                    android:textSize="30sp"
                    android:backgroundTint="@color/button_background"
                    android:textColor="@color/button_text"
                    android:elevation="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Fragment container -->
        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Navigation drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="false"
        android:background="@color/nav_background"
        android:elevation="8dp"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/navigation_menu"
        app:itemTextAppearance="@style/NavigationMenuTextAppearance"
        app:subheaderTextAppearance="@style/NavigationSubheaderTextAppearance"
        app:itemBackground="@drawable/nav_item_background"
        app:itemIconTint="@color/nav_icon_color_selector"
        app:itemTextColor="@color/nav_text_color_selector"
        app:itemIconSize="24dp"
        app:itemIconPadding="16dp"
        app:itemHorizontalPadding="16dp"
        app:itemVerticalPadding="16dp"
        app:dividerInsetStart="16dp"
        app:dividerInsetEnd="16dp"
        app:subheaderInsetStart="16dp" />

</androidx.drawerlayout.widget.DrawerLayout>