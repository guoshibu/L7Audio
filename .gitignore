# 项目排除路径

# 构建目录
/build/
/app/build/

# Gradle相关
/.gradle/

# 保留 gradle 目录下的配置文件（版本目录、wrapper 等）
# 但排除 gradle 下的临时/缓存子目录
!/gradle/

# 本地配置文件
local.properties

# 签名文件
release.keystore

# IDE配置文件
/.idea/
.idea/**/
*.iml
.vscode/

# 日志目录和文件
/logs/
*.log

# 临时文件
*.tmp
*.temp

# 备份目录
/backup_music_module/

# 构建输出文件
*.txt
build*.txt
*_log.txt
*_result.txt
*_output.txt
*_stderr.txt
*_stdout.txt
l7audio*.txt
install_output.txt
release_*.txt

# 脚本文件（本地构建用，不提交）
build.ps1
check_apk.ps1
deploy.ps1
diagnose.ps1
test.ps1
test2.ps1

# 保留 Gradle Wrapper（gradlew 和 gradlew.bat 必须提交）
!gradlew
!gradlew.bat

# 操作系统文件
.DS_Store
Thumbs.db

# 其他
/.trae/
*Trae CN*
Trae*

# APK 文件
*.apk

# 备份目录
backup_*/

# 本地构建脚本（不需要提交）
*.bat
do_build.bat
构建脚本.bat
